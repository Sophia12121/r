<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Showcase</title>
    <link rel="stylesheet" href="style.css">
</head>
<body class="light-mode">
    <header>
        <button id="theme-toggle" class="toggle-btn">Switch Theme</button>
    </header>

    <main class="gallery">
        <!-- Card 1 -->
        <div class="product-card">
            <div class="product-img">📦</div>
            <h3>Product Alpha</h3>
            <p>High-performance data modeling tool.</p>
        </div>
        <!-- Card 2 -->
        <div class="product-card">
            <div class="product-img">⚙️</div>
            <h3>Product Beta</h3>
            <p>Advanced optimization engine.</p>
        </div>
        <!-- Card 3 -->
        <div class="product-card">
            <div class="product-img">📊</div>
            <h3>Product Gamma</h3>
            <p>Real-time statistical visualizer.</p>
        </div>
    </main>

    <script src="script.js"></script>
</body>
</html>
