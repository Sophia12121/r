:root {
    --bg: #ffffff;
    --card-bg: #f8fafc;
    --text: #1e293b;
    --accent: #2563eb;
    --transition: 0.4s ease;
}

body.dark-mode {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text: #f8fafc;
    --accent: #38bdf8;
}

body {
    background-color: var(--bg);
    color: var(--text);
    transition: background-color var(--transition);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding-top: 50px;
}

/* Fade-in Animation */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.gallery {
    display: flex;
    gap: 2rem;
    animation: fadeIn 1s ease-out;
}

.product-card {
    background: var(--card-bg);
    padding: 2rem;
    border-radius: 12px;
    width: 250px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(128, 128, 128, 0.1);
}

/* Hover Effects */
.product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    border-color: var(--accent);
}

.toggle-btn {
    padding: 10px 20px;
    margin-bottom: 40px;
    cursor: pointer;
    border-radius: 20px;
    border: 2px solid var(--accent);
    background: transparent;
    color: var(--text);
    font-weight: bold;
}
